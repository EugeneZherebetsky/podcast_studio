{
  "name": "podcast-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter web run dev",
    "test": "pnpm -r run test",
    "lint": "eslint . && pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "pnpm --filter server run gen",
    "smoke": "pnpm --filter server run smoke",
    "autostart:install": "node scripts/autostart.mjs install",
    "autostart:remove": "node scripts/autostart.mjs remove"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2"
  }
}
