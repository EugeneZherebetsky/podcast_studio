# Copy to .env and fill in. Never commit .env.

PROFILE=cloud                 # cloud | local
HOST=127.0.0.1                # 0.0.0.0 to allow the phone over LAN (token required)
PORT=4747
DATA_DIR=./data
MONTHLY_BUDGET_USD=20

NATIVE_LANG=en
TARGET_LANG=hu
LEARNER_LEVEL=A1
# ALLOW_LOCAL_LEARNING=1       # opt in to graded/bilingual local learning despite quality risks

# --- LLM (cloud) ---
LLM_PROVIDER=anthropic        # anthropic | openai | google
LLM_MODEL_MAIN=               # look up the current model id in the provider docs
LLM_MODEL_FAST=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LLM (local) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_MAIN=qwen3.5:4b
OLLAMA_MODEL_FAST=qwen3.5:4b

# --- Search ---
# SEARCH_PROVIDER=             # tavily | brave | searxng. Unset: tavily on cloud, searxng on local
TAVILY_API_KEY=
BRAVE_API_KEY=
SEARXNG_URL=http://localhost:8888

# --- Text to speech ---
# TTS_PROVIDER=                # azure | openai | elevenlabs | piper. Unset: azure on cloud, piper on local
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
TTS_VOICE_HU_HOST=hu-HU-NoemiNeural
TTS_VOICE_HU_COHOST=hu-HU-TamasNeural
TTS_VOICE_NATIVE_HOST=
TTS_VOICE_NATIVE_TEACHER=
ELEVENLABS_API_KEY=
PIPER_DIR=./infra/piper
